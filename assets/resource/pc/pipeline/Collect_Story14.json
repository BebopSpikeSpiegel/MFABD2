{
    "Collect_Story14_Init": {
        "desc": "剧情14进入后安装完成标记，以探索告示板作为稳定采集起点。",
        "recognition": "Or",
        "any_of": [
            "Rec_SandBox_Pin_Tpl",
            "Rec_SandBox_Run_Tpl"
        ],
        "action": "Custom",
        "custom_action": "PatchPipeline",
        "custom_action_param": {
            "target": "Collect_IM_Closure",
            "patch": {
                "action": "Custom",
                "custom_action": "MarkComplete",
                "custom_action_param": {
                    "card_name": "Story_14_神圣审判",
                    "cycle_type": "g_weekly"
                }
